; 牧场物语风格 PC 单机游戏 · Godot 4 工程
; 配置全部来自 res://config/*.json，脚本内不写死数值。

config_version=5

[application]

config/name="牧场物语"
config/description="牧场物语风格的单机种田游戏（Godot 4）"
config/version="0.9.0"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://scenes/Farm.tscn"

[autoload]

ConfigBootstrap="*res://scripts/core/ConfigBootstrap.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
EventBus="*res://scripts/core/EventBus.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

